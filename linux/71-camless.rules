# camless: lets the user at the desk open the devices camless drives, the way
# liquidctl's 71-liquidctl.rules does, so the service runs as that user and needs no
# root. `uaccess` hands a device to whoever is logged in at the seat, through the
# seat rules that run after this file (73-seat-late.rules); the name sorts after
# systemd's 70-uaccess.rules too, as liquidctl's does. At the login screen the
# greeter's user has them; over SSH alone, nobody.
#
# Only these devices. Access to the hidraw or USB node of a keyboard or mouse would
# let any program of that user read what is typed, so the other products of these
# brands are not in here. A test in src/drivers/mod.rs checks that these lines
# match the drivers' models.
#
# linux/install.sh puts this file in /etc/udev/rules.d.

# NZXT: Kraken X2, M22, X3, Z3, 2023, Elite 2023, Elite 2024, Plus 2024; Control Hub,
# Smart Device (V1) and Grid+ V3.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="170e|1715|2007|2014|3008|300e|300c|3012|3014|2022|1714|1711", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="170e|1715|2007|2014|3008|300e|300c|3012|3014|2022|1714|1711", TAG+="uaccess"

# NZXT Smart Device V2; RGB & Fan Controller, and its 3+6 channel version; HUE 2,
# HUE 2 Ambient; RGB Controller.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2006|200d|200f|2009|200e|2010|2011|2019|201f|2020|2001|2002|2012|2021", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="2006|200d|200f|2009|200e|2010|2011|2019|201f|2020|2001|2002|2012|2021", TAG+="uaccess"

# Asetek-made Krakens X31, X41 and X61: a USB device, not HID.
SUBSYSTEM=="usb", ATTR{idVendor}=="2433", ATTR{idProduct}=="b200", TAG+="uaccess"

# Other brands' hubs, which camless drives only with [devices] other_brands on.

# Lian Li: Uni Hubs and the Strimer Plus V2's controller; the Uni Fan TL controller
# and the Galahad II AIOs.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0cf2", ATTRS{idProduct}=="7750|a100|a101|a102|a103|a104|a105|a106|a200", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0cf2", ATTR{idProduct}=="7750|a100|a101|a102|a103|a104|a105|a106|a200", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="7372|7371|7373|7395", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="7372|7371|7373|7395", TAG+="uaccess"

# Asiahorse Umbra V2.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe04", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="fe04", TAG+="uaccess"

# Corsair iCUE LINK System Hub.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c3f", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c3f", TAG+="uaccess"

# Corsair Commander Pro and the Obsidian 1000D's.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c10|1d00", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c10|1d00", TAG+="uaccess"

# Nollie's ARGB controllers, under their three vendor ids.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3061", ATTRS{idProduct}=="4714|4716", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3061", ATTR{idProduct}=="4714|4716", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="16d2", ATTRS{idProduct}=="1f01|1f11|1616|1617|1618", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="16d2", ATTR{idProduct}=="1f01|1f11|1616|1617|1618", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="16d5", ATTRS{idProduct}=="4714|4716|1f01|1f11|2a32|2a16|2a08|2c08|2a01", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="16d5", ATTR{idProduct}=="4714|4716|1f01|1f11|2a32|2a16|2a08|2c08|2a01", TAG+="uaccess"

# HYTE Smart Hub and Nexus Portal NP50, iBUYPOWER MiniHub: USB serial ports, which
# ModemManager would otherwise probe with modem commands.
SUBSYSTEM=="tty", ATTRS{idVendor}=="3402", ATTRS{idProduct}=="0900|0901|0904", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3402", ATTR{idProduct}=="0900|0901|0904", TAG+="uaccess"
